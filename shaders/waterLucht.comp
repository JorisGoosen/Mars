//WGSL reken-shader die de vochtcyclus bijwerkt in twee fasen:
//  damp (luchtVocht)  <->  wolken (gecondenseerd wolkwater)  <->  regen.
//De damp-capaciteit volgt de temperatuur; als er te veel damp is condenseert
//het tot wolkwater, en wolkwater regent uit (regen valt UITSCHLUITEND uit wolken).
//Wolken geven hun water ook af door terug te verdampen naar damp in droge lucht.
//
//Draait als laatste in de keten (na luchtStroming), dus vakken1 bevat al de
//verse wind, temperatuur, waterHoogte en bodemVocht van deze ronde.
#include "planeetDefinities.wgsl"

//Verzadigingsdampdruk, temperatuur-afhankelijk (exponentiële, Clausius-Clapeyron-
//achtige benadering: ~7%/K). Blijft positief bij elke temperatuur, zodat ook
//koude lucht een kleine maar reële dampcapaciteit houdt (een lineaire benadering
//klapt onder ~257 K door nul en laat dan de hele koude planeet droog staan).
const dynamischLift = 10.0; //hoe sterk convergentie de verzadiging verlaagt (wolkvorming)
fn sat_temp(T : f32) -> f32 {
    let q = reken.condenseer.x * exp(0.07 * (T - 250.0));
    return max(0.0001, q);
}

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3u) {
    let ID = gid.x;
    let aantal = arrayLength(&vakken0);
    if(ID >= aantal) { return; }

    let hier = vakMetas[ID].normaal.xyz;
    let burenAantal = vakMetas[ID].burenAantal;
    let n = f32(burenAantal);

    //Masterschakelaar: zonder atmosfeer (zonkracht reken.atmosfeer.x = 0) is er
    //geen wind, geen verdamping en geen neerslag; het water stroomt alleen nog.
    let luchtAan = select(0.0, 1.0, reken.atmosfeer.x > 0.0);

    //---- verse wind en temperatuur van deze ronde (uit luchtStroming) ----
    let wind = vakken1[ID].wind;
    let T    = vakken1[ID].temperatuur;

    //---- advectie van damp en wolkwater met de wind (fluxvormig, behoudend) ----
    //vochtStroming heeft per rand de upwind flux al in de vochtpijpen gezet (met
    //dezelfde face-snelheid als T/P in luchtStroming, dus één gezamenlijke luchtcel).
    //Hier sommeert elke cel de NETTO-instroming: pijp van de buur-zijde min eigen
    //pijp, per rand antisymmetrisch, zodat de totale damp+wolk exact behouden blijft.
    var netDamp = 0.0;
    var netWolk = 0.0;
    for(var fv = 0u; fv < burenAantal && fv < maxBuren; fv++) {
        let nb = vakMetas[ID].buren[fv];
        let nbAantal = vakMetas[nb].burenAantal;
        for(var rv = 0u; rv < nbAantal && rv < maxBuren; rv++) {
            if(vakMetas[nb].buren[rv] == ID) {
                netDamp += vakken1[nb].vochtPijpenA[rv] - vakken1[ID].vochtPijpenA[fv];
                netWolk += vakken1[nb].vochtPijpenB[rv] - vakken1[ID].vochtPijpenB[fv];
                break;
            }
        }
    }
    let dampAan = vakken0[ID].luchtVocht + netDamp;
    let wolkAan = vakken0[ID].wolken + netWolk;

    //---- verzadiging uit de temperatuur (+ hoogte + orografie) ----
    let oppervlak = vakken0[ID].grondHoogte + vakken0[ID].waterHoogte;
    let hoogteFrac = clamp((oppervlak - minGrondHoogte) / (maxGrondHoogte - minGrondHoogte), 0.0, 1.0);

    //Stroomafwaartse buur (waar de wind heen gaat) voor orografische stijging.
    var afId = ID;
    var besteAf = -1.0;
    var divU = 0.0;
    var somWolk = 0.0;
    for(var buur = 0u; buur < burenAantal && buur < maxBuren; buur++) {
        let mee = dot(vakMetas[ID].buurRicht[buur], wind);
        if(mee > besteAf) { besteAf = mee; afId = vakMetas[ID].buren[buur]; }
        divU += windUC(ID, buur);
        somWolk += vakken0[vakMetas[ID].buren[buur]].wolken;
    }
    divU /= max(n, 1.0);
    somWolk /= max(n, 1.0);

    //Orografische stijging: stroomafwaarts stijgt het oppervlak => de lucht wordt
    //omhooggeduwd, koelt en kan minder damp houden (lagere verzadiging).
    let oppervlakAf = vakken1[afId].grondHoogte + vakken1[afId].waterHoogte;
    let stijgOp     = max(0.0, min(oppervlakAf - oppervlak, 1.0));
    let stijgTerm   = clamp(reken.condenseer.w * stijgOp, 0.0, 0.9);

    //Dynamische opwaartse stroming: waar de wind convergeert (negatieve divergentie
    //van de compressie-gecorrigeerde face-snelheid) wordt lucht omhooggeduwd, koelt
    //af en condenseert. Dit vormt bewolking in echte circulatie-systemen i.p.v.
    //louter onder de zon.
    let convergentie = -divU;
    let dynLift      = clamp(convergentie * dynamischLift, 0.0, 0.95);

    var verzadiging = sat_temp(T) * (1.0 - stijgTerm - (1.0 - stijgTerm) * dynLift) - reken.condenseer.y * hoogteFrac;
    verzadiging = max(0.0001, verzadiging);

    //---- condensatie: oververzadigde damp wordt wolkwater ----
    var damp = dampAan;
    var wolk = wolkAan;
    if(luchtAan > 0.0 && damp > verzadiging + zeerKlein) {
        let overschot = (damp - verzadiging) * condensTempo;
        wolk += overschot;
        damp -= overschot;
    }

    //---- wolkverdamping: in droge lucht geeft wolkwater vocht terug aan de lucht
    if(luchtAan > 0.0 && damp < verzadiging - zeerKlein && wolk > zeerKlein) {
        let tekort  = verzadiging - damp;
        let afdamp  = min(min(wolk * wolkVerdamp, tekort * 0.1), wolk);
        damp += afdamp;
        wolk -= afdamp;
    }

    //---- regen uitsluitend uit wolken (boven de draagkracht valt het uit) ----
    var regen = max(0.0, wolk - wolkDraagKracht) * regenTempo * (reken.condenseer.z / 0.3) * luchtAan;
    regen = min(regen, max(0.0, wolk));
    wolk -= regen;

    //---- wolkdiffusie: nabije patchjes vloeien samen tot grotere wolkendekken ----
    wolk += wolkDiffusie * (somWolk - wolk);

    //---- wolkendek onder de grond: een cel mag nooit vocht bevatten dat hoger
    //reikt dan het wolkendek. Ligt het lokale dek onder de grond (bergtop steekt
    //boven het dek uit), dan kan die lucht haar vocht niet vasthouden: al het damp
    //en wolkwater slaat onmiddellijk neer als regen/lopend water.
    //
    //Het dek is een soepele, stabiele hoogte (vooral uit temperatuur/pressuur,
    //niet uit de huidige damp: anders versterkt het wegdrainen zichzelf en zakt
    //het dek naar de grond tot er geen vocht meer over is). Het zweeft in de
    //atmosfeerlaag tussen sealevel (1.0) en het plafond.
    let maxGrond = max(reken.fasen.y, 1.0);
    let grondMult = max(reken.fasen.z, 0.0001);
    let rMax      = (1.0 + maxGrond * reken.grondSchaal) / grondMult;
    let rPlafond  = 1.0 + 0.9 * (rMax - 1.0);
    //dekFract uit temperatuur (warm = hoger dek): het dek zweeft hoog in de
    //atmosfeerlaag zodat alleen hoge bergtoppen erbovenuit steken; daarmee blijft
    //er voor de meeste cellen ruimte om vocht vast te houden en wolken te vormen.
    let dekFract  = clamp(0.75 + 0.15 * clamp((T - 255.0) / 30.0, -1.0, 1.0), 0.6, 0.9);
    let rWolk     = 1.0 + dekFract * (rPlafond - 1.0);
    let grondR    = (1.0 + vakken0[ID].grondHoogte * reken.grondSchaal) / grondMult;
    if(luchtAan > 0.0 && grondR >= rWolk && wolk > zeerKlein) {
        regen += wolk;
        wolk  = 0.0;
    }

    //---- oppervlakte-verdamping boven water (zon-afhankelijk) ----
    //Bevroren water verdampt niet: onder het vriespunt staat de stoom-productie uit.
    //Zonder verzadigings-plafond kan damp de verzadiging overschrijden, waarna de
    //condensatie er wolkwater van maakt i.p.v. dat het vocht in de lucht blijft hangen.
    let zon = select(vec3f(0.0, 1.0, 0.0), normalize(reken.zonRicht.xyz), length(reken.zonRicht.xyz) > zeerKlein);
    //zonZicht (vorige ronde, door luchtStroming uit de schaduwkaart gehaald) dempt
    //het licht waar terrein de cel overschaduwt.
    let licht = max(0.0, dot(hier, zon)) * vakken0[ID].zonZicht;
    let vriest = select(0.0, 1.0, T < vriespuntK);

    //Sneeuw boven ijs/kou: onder het vriespunt wordt neerslag meteen ijs ("sneeuw")
    //i.p.v. vloeibaar water dat traag moet bevriezen en anders wegsublimeert. Zo werken
    //wolken/buien boven ijskappen gewoon en vult neerslag de ijskap direct aan. ijs zit
    //in het waterbudget, dus dit is een pure reservoir-overdracht (behoudend).
    let sneeuw     = select(0.0, regen, vriest > 0.0);
    let regenWater = regen - sneeuw;
    var ijsNieuw   = vakken1[ID].ijs + sneeuw;

    var waterNieuw = vakken1[ID].waterHoogte + regenWater;
    let stoom = luchtAan * (1.0 - vriest) * min(reken.verdamping * licht * min(1.0, waterNieuw * 5.0), waterNieuw);
    waterNieuw -= stoom;
    damp += stoom;

    //Sublimatie: ook bevroren oppervlak (ijs/sneeuw) levert langzaam damp aan de
    //lucht, anders verdrogen de polen permanent (geen andere vochtbron daar).
    let ijsBeschikbaar = vakken1[ID].ijs;
    let sublim = luchtAan * vriest * min(reken.verdamping * licht * min(1.0, ijsBeschikbaar * 5.0), ijsBeschikbaar);
    ijsNieuw -= sublim;
    damp += sublim;

    //---- evapotranspiratie: vochtige bodem verdroogt naar droge lucht ----
    //Conservatief: damp krijgt nooit meer dan de bodem écht inlevert (min met de
    //beschikbare bodemvocht), zodat er nooit vocht uit het niets ontstaat.
    //Geschaald met reken.verdamping / 0.002 (de standaardverdamping), zodat de
    //K/L-toets óók de bodemverdamping raakt (anders bleven er wolken komen als
    //verdamping=0).
    let evapot = evapotranspiratie * reken.verdamping / 0.002;
    let verdroogt = luchtAan * evapot * vakken1[ID].bodemVocht * max(0.0, verzadiging - damp);
    var bodemVochtNieuw = vakken1[ID].bodemVocht;
    if(verdroogt > zeerKlein) {
        let af = min(verdroogt, bodemVochtNieuw);
        bodemVochtNieuw = bodemVochtNieuw - af;
        damp += af;
    }

    vakken1[ID].waterHoogte = goed(waterNieuw,  vakken0[ID].waterHoogte, 0.0, maxWaterHoogte);
    vakken1[ID].bodemVocht  = goed(bodemVochtNieuw, vakken0[ID].bodemVocht, 0.0, maxWaterHoogte);
    vakken1[ID].luchtVocht  = goed(damp, vakken0[ID].luchtVocht, 0.0, maxLuchtVocht);
    vakken1[ID].wolken      = goed(wolk, vakken0[ID].wolken, 0.0, maxLuchtVocht);
    vakken1[ID].ijs         = goed(ijsNieuw, vakken0[ID].ijs, 0.0, maxWaterHoogte);
}
