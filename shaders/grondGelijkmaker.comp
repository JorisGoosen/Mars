//WGSL reken-shader die het zand weer een beetje bij de hand neemt:
//zand zakt naar een rusthelling (angle of repose ~30°). Als een cel hoger ligt
//dan zijn buur, dan mag een deel van het overschot naar de lagere buur 'vallen'.
//Rots beweegt nooit; alleen de zandlaag (grondHoogte - rotsHoogte) verplaatst.
//
//Eenvoudig en stabiel: per ronde draagt een cel maximaal zandZakhoek (1/6) van de
//overmaat boven de drempel zandRepose af aan elke lagere buur. De uitwisseling is
//symmetrisch (A->B en B->A vallen precies tegen elkaar weg), zodat de totale
//zandhoeveelheid behouden blijft.
//
//BELANGRIJK: deze shader raakt ALLEEN de grond-lanes (grondHoogte, rotsHoogte,
//grondSoort). Alle andere vakken1-velden (water, droesem, leven, ijs, ...) laat
//hij met rust, want die worden door de andere reken-passen (b.v. waterDruk) in
//dezelfde ronde geschreven.
#include "planeetDefinities.wgsl"

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3u) {
    let ID = gid.x;
    let aantal = arrayLength(&vakken0);
    if(ID >= aantal) { return; }

    let burenAantal = vakMetas[ID].burenAantal;

    let mijnGrond = vakken0[ID].grondHoogte;
    let mijnRots  = vakken0[ID].rotsHoogte;
    let mijnZand  = max(0.0, mijnGrond - mijnRots);

    //Symmetrische netto zanduitwisseling over de buren. Per buur wordt gekeken
    //of wij hoger liggen (dan zenden wij zand) of lager (dan ontvangen wij zand,
    //beperkt tot de zandlaag van die hogere buur).
    var netZand = 0.0;

    for(var buur = 0u; buur < burenAantal && buur < maxBuren; buur++) {
        let buurId = buurID(ID, buur);
        let buurGrond = vakken0[buurId].grondHoogte;
        let buurRots  = vakken0[buurId].rotsHoogte;
        let buurZand  = max(0.0, buurGrond - buurRots);

        let verskil = mijnGrond - buurGrond;

        if(verskil > zandRepose) {
            //wij liggen hoger: zand 'valt' naar de lagere buur
            let oorskot = verskil - zandRepose;
            let donatie = min(zandZakhoek * oorskot, mijnZand);
            netZand -= donatie;
        }
        else if(verskil < -zandRepose) {
            //de buur ligt hoger: hij stuurt ons zand (beperkt tot z'n zandlaag)
            let oorskot = -verskil - zandRepose;
            let donatie = min(zandZakhoek * oorskot, buurZand);
            netZand += donatie;
        }
    }

    let nuweZand = max(0.0, mijnZand + netZand);

    vakken1[ID].rotsHoogte  = mijnRots;                              //rots blijft staan
    vakken1[ID].grondHoogte = goed(mijnRots + nuweZand, mijnGrond, minGrondHoogte, maxGrondHoogte);

    //oppervlak is zand zodra er een deklaagje boven de rots ligt
    if(vakken1[ID].grondHoogte - mijnRots > zeerKlein) {
        vakken1[ID].grondSoort = i32(gsZand);
    }
    else {
        vakken1[ID].grondSoort = i32(gsRots);
    }
}
