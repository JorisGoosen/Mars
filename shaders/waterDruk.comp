//WGSL reken-shader die de waterdruk, het vocht, de droesem en het leven bijwerkt.
//We hebben net in waterStroming.comp naar vakken1 geschreven, dus de nieuwe
//stromingswaardes staan daar. Maar we willen alsnog de nieuwe waterHoogte etc
//naar vakken1 schrijven, dus opletten.
#include "planeetDefinities.wgsl"

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3u) {
    let ID = gid.x;
    let aantal = arrayLength(&vakken0);
    if(ID >= aantal) { return; }

    let n = vakMetas[ID].normaal.xyz;
    let burenAantal = vakMetas[ID].burenAantal;
    var stroming = 0.0;
    var buurVocht = 0.0;
    let mijnVocht = vakken0[ID].vocht;
    var buurLeven = 0.0;
    var droesem = 0.0;
    var snelheid = vec2f(0.0);

    //Ga de buren telkens opzoeken zodat we normalen kunnen berekenen en zo veel meer
    for(var buur = 0u; buur < burenAantal && buur < maxBuren; buur++) {
        let buurIDv = vakMetas[ID].buren[buur];
        let buurBuren = vakMetas[buurIDv].burenAantal;

        for(var buurBuur = 0u; buurBuur < buurBuren; buurBuur++) {
            if(vakMetas[buurIDv].buren[buurBuur] == ID) {
                let stroomBinnen = vakken1[buurIDv].pijpen[buurBuur] - vakken1[ID].pijpen[buur];

                stroming += stroomBinnen;
                buurVocht += (vakken1[buurIDv].vocht - mijnVocht) / 6.0;
                buurLeven += vakken1[buurIDv].leven;
                snelheid += vakMetas[ID].buurRicht[buur] * stroomBinnen;

                //Als stroomBinnen positief is komt het binnen
                let andId = select(ID, buurIDv, stroomBinnen >= 0.0);

                if(vakken0[andId].waterHoogte > minWaterSed && abs(stroomBinnen) > zeerKlein) {
                    droesem += sign(stroomBinnen) * clamp(abs(stroomBinnen / pijpLengte), 0.0, 1.0) * max(0.0, vakken0[andId].droesem);
                }

                break;
            }
        }
    }

    //Dan tijd om het een en ander weg te schrijven
    snelheid /= f32(burenAantal);
    vakken1[ID].snelheid     = snelheid;
    vakken1[ID].plek         = vakken0[ID].plek + snelheid;
    vakken1[ID].waterHoogte  = max(0.0, (vakken0[ID].waterHoogte + (stroming / pijpLengte)) - reken.verdamping);
    vakken1[ID].vocht        = max(0.0, mijnVocht + buurVocht + min(reken.verdamping, vakken0[ID].waterHoogte));

    if(!(droesem >= -1.0e30 && droesem <= 1.0e30)) {
        droesem = 0.0;
    }

    let helling = 1.0;
    var droesemCapaciteit = droesemheid * clamp(length(snelheid) * vertrager, 0.0, 1.0) * helling;

    if(!(droesemCapaciteit >= -1.0e30 && droesemCapaciteit <= 1.0e30)) {
        droesemCapaciteit = 0.0;
    }

    let droesemAangespoeld = droesem + vakken0[ID].droesem;

    droesem = droesemAangespoeld - droesemCapaciteit;

    vakken1[ID].grondSoort = vakken0[ID].grondSoort;

    if(vakken1[ID].waterHoogte <= zeerKlein && droesemAangespoeld > zeerKlein) {
        vakken1[ID].droesem     = 0.0;
        vakken1[ID].grondHoogte = vakken0[ID].grondHoogte + droesemAangespoeld;

        if(droesemAangespoeld > toonSediment) {
            vakken1[ID].grondSoort = i32(gsLoess);
        }
    }
    else if(abs(droesem) > zeerKlein) {
        droesem *= select(oplosheid, bezinkheid, droesem >= 0.0);

        if(droesem < 0.0) { //== oplossen
            if(-droesem > vakken0[ID].grondHoogte - minGrondHoogte) {
                droesem = vakken0[ID].grondHoogte - minGrondHoogte;
            }

            if(vakken1[ID].waterHoogte < minWaterSed) {
                droesem = 0.0;
            }
        }
        else if(droesem >= 0.0) { //== bezinken
            if(vakken1[ID].waterHoogte < minWaterSed) {
                droesem = droesemAangespoeld * bezinkheid;
            }

            if(vakken0[ID].grondHoogte + droesem > maxGrondHoogte) {
                droesem = maxGrondHoogte - vakken0[ID].grondHoogte;
            }
        }

        vakken1[ID].droesem     = droesemAangespoeld - droesem;
        vakken1[ID].grondHoogte = vakken0[ID].grondHoogte + droesem;

        if(abs(droesem) > toonSediment) {
            vakken1[ID].grondSoort = i32(gsLoess);
        }
    }
    else {
        vakken1[ID].droesem     = 0.0;
        vakken1[ID].grondHoogte = vakken0[ID].grondHoogte;
    }

    var leven = vakken0[ID].leven;
    let regen = dot(reken.regenPlek.xyz, n);

    if(length(reken.regenPlek.xyz) > 0.0) {
        //het lekker laten regenen
        if(abs(regen) > 0.999) {
            let minWaterErbij = vakken1[ID].vocht * 0.3333;
            let minderVochtig = minWaterErbij;

            vakken1[ID].waterHoogte += minderVochtig;
            vakken1[ID].vocht       -= minderVochtig;
        }
        else if(-regen > 0.98) {
            leven = max(0.00001, leven);
        }
    }

    //hoop doet leven
    buurLeven /= f32(burenAantal);

    let isZand = vakken1[ID].grondSoort == i32(gsZand) || vakken1[ID].grondSoort == i32(gsLoess);

    let rotsGroei = 1.0001;
    let rotsBuur  = 0.003333;
    let zandGroei = 1.01;
    let zandBuur  = 0.03333;
    let groei     = select(rotsGroei, zandGroei, isZand);
    let buurG     = select(rotsBuur,  zandBuur,  isZand);

    if(vakken1[ID].waterHoogte <= 0.05) {
        leven = max(0.0, min(vakken1[ID].vocht, max(leven * groei, leven + (buurLeven * buurG))));
    }
    else if(vakken1[ID].waterHoogte > 2.0) {
        leven *= 0.85;
    }
    else {
        leven *= 0.95;
    }

    vakken1[ID].leven = leven;
}