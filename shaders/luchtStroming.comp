//WGSL reken-shader die de atmosferische dynamica bijwerkt: een enkellaagse
//(barotrope-achtige) circulatie met temperatuur, druk en een opgeslagen windveld.
//Dit vervangt de oude synthetische wind die elke frame uit een draaiende as werd
//verzonnen: hier evolueren T/P/wind écht, aangedreven door zonne-verwarming
//(dag/nacht + breedte), Coriolis (planeetrotatie), drukgradiënten, wrijving en
//diffusie. Straalstromen/banden ontstaan vanzelf.
//
//Voor numerieke stabiliteit op de onregelmatige geodesische grid is de wind zwaar
//gedempt (Rayleigh), begrensd op maxWindsnel en gladgestreken; de druk reageert
//zacht op divergentie en warmte en wordt sterker gediffundeerd.
//
//Draait ná waterGemiddelde en vóór waterLucht. Leest T/P/wind uit vakken0,
//schrijft de nieuwe waarden naar vakken1.
#include "planeetDefinities.wgsl"

//De schaduwkaart van de zon (bind-groep 1, door het framework gebonden; het witte
//hulpje als er geen kaart is). Wordt gebruikt om terrein-schaduw (bergen die dalen
//overschaduwen) in de instraling mee te nemen.
@group(1) @binding(0) var zonSchaduwKaart : texture_2d<f32>;
@group(1) @binding(1) var zonSchaduwSmp   : sampler;

#include "zonSchaduwPCF.wgsl"

//De wind wordt zwaarder gedempt (Rayleigh) en zwakker door de drukgradiënt
//aangedreven dan voorheen, zodat de velden onder de cap blijven en er coherente
//(grootschalige, samenhangende) circulatie-ellipsen/banden ontstaan i.p.v. dat
//élke cel tegelijk tegen de cap maxWindsnel wordt geperst (waar de richtingen
//onderling uitmiddelen tot ~0 en de wolken niets om te dragen hebben).
const maxWindsnel  = 10.0;    //abs. windsnelheidsgrens
const drukGevolg   = 0.0005;   //hoe sterk wind-divergentie de druk verandert
const coriolisKracht = 0.5; //rotatiehoek per ronde = f·k; versterkt voor een sterker horizontaal (zonaal) rotatiecomponent; exacte rotatie = onvoorwaardelijk stabiel
const terrainKracht  = 0.001; //schaal van de terrein-forcering (wervels rond bergen, minder ruis)

//Temperatuur en druk advecteren veel zwakker mee dan het vocht: alleen een zachte
//meetrek-beweging (sub-cel), zodat de diffusie/uitstraling kan overheersen en er
//geen fijnschalige draaikolken/ruis in T/P ontstaan. Het vocht (damp/wolk) advecteert
//voluit via vochtStroming; hier voldoet een zwakke druk/waarde meebewegen.
const TPAdvectieZwakte = 0.12;
const windAdvectie  = 0.1;  //hoe sterk de wind zijn eigen impulsie stroomafwaarts meeneemt (jets/richtingswind die uitlopen in buurcellen)

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3u) {
    let ID = gid.x;
    let aantal = arrayLength(&vakken0);
    if(ID >= aantal) { return; }

    let hier = vakMetas[ID].normaal.xyz;
    let burenAantal = vakMetas[ID].burenAantal;
    let n = f32(burenAantal);

    //Wrijving en wind-diffusie komen uit de rekenparameters (toetsen O/P en de
    //vlaggen), zodat de demping interactief te tunen is.
    let winddemping  = max(0.0, reken.atmosfeer.z);
    //Diffusie smoort fysiek ~coëfficiënt·d² per ronde; bij fijnere cellen (hogere
    //--diepte) moet de cel-coëfficiënt dus mee schalen (4^(diepte-6), geklemd op
    //0.8 voor expliciete stabiliteit) om dezelfde fysieke schalen te dempen.
    let resSchaal      = max(0.25, reken.fasen.w);
    let windDiffusieS  = min(0.8, max(0.0, reken.atmosfeer.w) * resSchaal);
    let drukDiffusieS  = min(0.8, drukDiffusie * resSchaal);
    let tempDiffusieS  = tempDiffusie; //niet resolutieschalen: T-ruis wordt door de drukdiffusie onschadelijk gemaakt, en ongeschaald blijft het dag/nacht- en albedocontrast op hoge diepte staan

    //Masterschakelaar: zonkracht (reken.atmosfeer.x) > 0 zet de circulatie aan.
    //Met 0 blijft de lucht volledig stil (handig als --no-atmosfeer-parachute).
    let luchtAan = select(0.0, 1.0, reken.atmosfeer.x > 0.0);

    let opp = vakken0[ID].grondHoogte + vakken0[ID].waterHoogte;
    let hoogteFrac = clamp((opp - minGrondHoogte) / (maxGrondHoogte - minGrondHoogte), 0.0, 1.0);

    let T0 = vakken0[ID].temperatuur;
    let P0 = vakken0[ID].luchtdruk;
    let V0 = vakken0[ID].wind;

    //---- zonne-verwarming (zon vast in modelruimte; de planeet draait) ----
    let zon     = normalize(reken.zonRicht.xyz);
    //Instralingshoek: vergelijk de normaal van de cel (naar buiten) met de
    //invalsrichting van het licht. Als de normaal naar de zon wijst (dot==+1) is de
    //instraling maximaal; zodra de normaal weg of haaks op het licht staat (dot<=0)
    //is er geen instraling meer. Kwadratisch, zodat scherende straling relatief
    //zacht afvalt (minder extreme lokale hotspots).
    let dagKant = dot(hier, zon);

    //Terrein-schaduw uit de schaduwkaart: bergen/flanken die tussen de cel en de zon
    //staan dempen de instraling. De cel wordt hiervoor op zijn RENDER-positie gezet
    //(zelfde afbeelding als de schaduw-pass: vakHoogte/grondMult) en analytisch in
    //het orthografische zon-kader geprojecteerd (zonProjectie). Het resultaat
    //(zonZicht, 0..1) wordt ook opgeslagen zodat de verdamping en de diagnose het
    //kunnen gebruiken. Buiten de dagzijde is er geen instraling en dus niets te
    //overschaduwen (zonZicht blijft dan 1.0: geen terrein-schaduw).
    var zonZicht = 1.0;
    if(reken.schaduw.x > 0.5 && dagKant > 0.0 && reken.schaduw.y > 0.5) {
        let straal = zonStraal(reken.fasen.z, reken.grondSchaal, reken.fasen.y);
        //zelfde oppervlak als de schaduw-pass: terrein + ijs (water telt niet mee)
        let kolomHoogte = vakken0[ID].grondHoogte + vakken0[ID].ijs;
        let plek   = hier * ((1.0 + kolomHoogte * reken.grondSchaal) / reken.fasen.z);
        let pr     = zonProjectie(plek, zon, straal);
        zonZicht   = zonSchaduwFactor(pr, reken.schaduw.y);
    }

    let ins     = pow(max(0.0, clamp(dagKant, 0.0, 1.0)), 2.0) * zonZicht;
    let noord   = vec3f(0.0, 1.0, 0.0);              //vaste geografische rotatie-as
    let breedte = clamp(dot(hier, noord), -1.0, 1.0); //+1 = noordpool
    //Zonale profiel: 1 aan de evenaar, 0 aan de polen. Bepaalt zowel de vaste
    //rotatiewind als het Coriolis-veld (max aan de evenaar, niets aan de polen).
    let zonal = sqrt(max(0.0, 1.0 - breedte * breedte));

    //In het planeet-vaste frame is co-rotatie gewoon wind≈0; rotatie werkt alleen
    //via Coriolis en de dag/nachtcyclus. Een opgelegde oostwind (zoals voorheen)
    //wordt door Coriolis op beide halfronden naar de evenaar gepompt en zuigt zo
    //alle vocht in één band — vandaar geen V_rot-attractor meer.
    let V_rot = vec2f(0.0);

    //Echte energiebalans (geen breedte-verzonnen evenwicht meer):
    // 1) zoninstraling met invalshoek (ins = cos van de zonhoogte; scherende
    //    straling valt over meer oppervlak -> minder warmte per cel),
    // 2) gemoduleerd door het albedo van de getoonde oppervlakte (ijs/wolk/water/grond/leven),
    // 3) uitstraling naar de ruimte, afgeremd door het wolkendek,
    // 4) CO2-broeikaseffect zodat niet de hele planeet bevriest.
    //De lucht-T telt door van de vorige stap en wordt advecteerd met de wind.
    //LET OP select(f,t,c) = c ? t : f: onderstaande keten stond eerder omgekeerd,
    //waardoor bijna de hele planeet albedoIJs kreeg en de oppervlakte-albedo's
    //niets deden. Nu correct, met gradueel wolk-albedo: dunne wolken reflecteren
    //gedeeltelijk, dikke dekken volledig.
    let ondergrond   = select(albedoGrond, albedoWater, vakken0[ID].waterHoogte > 0.5);
    let metWolk      = mix(ondergrond, albedoWolken, clamp(vakken0[ID].wolken / 0.2, 0.0, 1.0));
    let lokaalAlbedo = select(metWolk, albedoIJs, vakken0[ID].ijs > 0.01);
    let albedo = mix(lokaalAlbedo, albedoBegroei, clamp(vakken0[ID].leven, 0.0, 1.0));

    let zonWarmte = reken.atmosfeer.x * (1.0 - albedo) * ins;

    //Wolkendek houdt de uitstraling deels tegen (atmosfeer wordt 'dikker' waar bewolkt)
    let wolkBedekking = clamp(vakken0[ID].wolken * 10.0, 0.0, 1.0);
    let afkoelen = stralingKracht * (1.0 - wolkIsolatie * wolkBedekking);

    //Effectieve hemeltemperatuur door CO2-broeikaseffect, met hoogte-koeling
    //(lapse rate) ingebouwd in het stralingsevenwicht: hoger -> kouder doel.
    let ruimteEffectief = ruimteK + broeikasK - lapseKoeling * hoogteFrac;

    //---- advectie van T, P en impulsie met de wind (fluxvormig, donor-cel) ----
    //Eén gezamenlijke "luchtcel" verplaatst zich: temperatuur, druk én impulsie
    //reizen met díézelfde face-snelheid (windUC) als het vocht in vochtStroming,
    //zodat alle atmosferische grootheden als één gemengd luchtpakket meebewegen.
    //Impulsie-advectie laat richtingswind/jets stroomafwaarts uitlopen in de
    //buurcellen i.p.v. dat elke cel alleen op lokale krachten reageert.
    //De verschilvorm (don - eigen) is compressievrij: de residu-compressie van
    //het discrete windveld wordt niet vermenigvuldigd met de absolute waarde.
    let oost0  = vakMetas[ID].oost.xyz;
    let noord0 = vakMetas[ID].noord.xyz;
    let V3_0   = V0.x * oost0 + V0.y * noord0;
    var netT = 0.0;
    var netP = 0.0;
    var netW3 = vec3f(0.0);
    var minTN = T0; var maxTN = T0;
    var minPN = P0; var maxPN = P0;
    for(var av = 0u; av < burenAantal && av < maxBuren; av++) {
        let avU  = windUC(ID, av);
        let avNb = vakMetas[ID].buren[av];
        let c    = dtAdvPerL() * TPAdvectieZwakte;
        let cW   = dtAdvPerL() * windAdvectie;
        let Tnb  = vakken0[avNb].temperatuur;
        let Pnb  = vakken0[avNb].luchtdruk;
        let Tdon = select(Tnb, T0, avU >= 0.0);
        let Pdon = select(Pnb, P0, avU >= 0.0);
        let V3don = select(wind3(avNb), V3_0, avU >= 0.0);
        netT -= avU * (Tdon - T0) * c;
        netP -= avU * (Pdon - P0) * c;
        netW3 -= avU * (V3don - V3_0) * cW;
        minTN = min(minTN, Tnb); maxTN = max(maxTN, Tnb);
        minPN = min(minPN, Pnb); maxPN = max(maxPN, Pnb);
    }
    //Monotone flux-limiter: klemm de geadveteerde waarde op het buurbereik (inclusief
    //zichzelf), zodat er nooit NIEUWE extremen ontstaan => onvoorwaardelijk stabiel
    //(geen zelfversterkende hete/koude clusters). Behoud van de middeling blijft behouden
    //zolang de limiter enkel overshoot afknipt; dit is de FCT-achtige garantie.
    let T_adv = clamp(T0 + netT, minTN, maxTN);
    let P_adv = clamp(P0 + netP, minPN, maxPN);
    let W_adv = lokaal2(ID, netW3);

    //---- wind: drukgradiënt + Coriolis + wrijving + diffusie + terrein ----
    //Vectorgrootheden (wind, windverschillen) worden in 3D gecombineerd: de
    //lokale raakvlak-basisjes draaien tussen buren, dus componenten rechtstreeks
    //optellen leest die rotatie als valse divergentie/diffusie, systematisch
    //langs de icosahedron-hoofdvlakken (sterpatroon in druk, ruiten in wind).
    var somW3    = vec3f(0.0);
    var gradiënt = vec2f(0.0);
    var somP     = 0.0;
    var somT     = 0.0;
    var rawDivX  = vec2f(0.0);
    var rawDivY  = vec2f(0.0);
    var terreinGrad = vec2f(0.0);
    for(var buur = 0u; buur < burenAantal && buur < maxBuren; buur++) {
        let buurId = buurID(ID, buur);
        let richt  = vakMetas[ID].buurRicht[buur];
        somW3    += wind3(buurId);
        gradiënt += (vakken0[buurId].luchtdruk - P0) * richt;
        somP     += vakken0[buurId].luchtdruk;
        somT     += vakken0[buurId].temperatuur;
        let dV    = lokaal2(ID, wind3(buurId) - V3_0);
        rawDivX  += dV.x * richt;
        rawDivY  += dV.y * richt;
        terreinGrad += (vakken0[buurId].grondHoogte - vakken0[ID].grondHoogte) * richt;
    }
    let somW = lokaal2(ID, somW3 / n - V3_0) + V0;
    somP     /= n;
    somT     /= n;
    //Least-squares divergentie (zelfde correctiematrix als de gradient): de kale
    //som dot(dV, richt) leest op dit onregelmatige grid de schuifspanning van de
    //wind als valse divergentie, en die anisotropie ligt systematisch langs de
    //icosahedron-hoofdvlakken (sterpatroon in druk/wind/temperatuur).
    let wDiv = vakMetas[ID].gradWeights;
    let div  = (wDiv.x * rawDivX.x + wDiv.y * (rawDivX.y + rawDivY.x) + wDiv.z * rawDivY.y) * vakMetas[ID].gradSchaal;
    let gradP = applyGradWeights(ID, gradiënt) * vakMetas[ID].gradSchaal;
    let gradH = applyGradWeights(ID, terreinGrad) * vakMetas[ID].gradSchaal;

    //---- temperatuur-update: warmte erbij (zon), af (uitstraling) + diffusie ----
    //Zonder atmosfeer (reken.atmosfeer.x = 0) blijft de temperatuur stil.
    //Diffusie (somT - T_adv) verdeelt de warmte over de buren: zonder dit blijft
    //de dagzijde te heet en te droog en de nachtzijde te koud, waardoor damp nooit
    //in de buurt van verzadiging komt en er geen wolken ontstaan.
    let T1 = select(T_adv,
        T_adv
        + opnameTempo * zonWarmte * tijdVerschil
        - afkoelen * (T_adv - ruimteEffectief) * tijdVerschil
        + tempDiffusieS * (somT - T_adv),
        luchtAan > 0.0);

    //Coriolis: f = 2 Omega * sin(breedte) — fysiek correct nul op de evenaar en
    //maximaal aan de polen (breedte = normaal·noordas = sin(breedtegraad)).
    let fgeo = 2.0 * reken.atmosfeer.y * breedte;

    //Terrein-forcering: het vaste hoogteveld buigt de stroming om bergen/flanken
    //heen en werkt als een permanente (fysieke) ruisbron. Flow die een helling
    //oversteekt krijgt verticale vorticiteit → benedenstrooms ontstaan kolken en
    //heuvelluwten die door de wind worden meegevoerd.
    let terreinDruk = clamp(dot(V0, gradH), -1.0, 1.0);
    let terreinForce = terrainKracht * (gradH * (1.0 + 2.0 * terreinDruk));

    var V1 = V0
           - drukKracht * gradP                       //drukgradiëntkracht
           + terreinForce                                 //terrein (wervels/omleiding)
           - winddemping * (V0 - V_rot)                 //Rayleigh-wrijving
           + windDiffusieS * (somW - V0)                 //diffusie: smoot de wind tot grootschalige, coherente stroming
           + W_adv;                                     //impulsie-advectie: richtingswind loopt uit in buurcellen

    //Coriolis als exacte rotatie na alle krachten: onvoorwaardelijk stabiel,
    //in tegenstelling tot een expliciete loodrechte krachtterm. Rechtsom op het
    //noordelijk halfrond (f>0) => afbuiging rechts van de bewegingsrichting.
    let theta = fgeo * coriolisKracht;
    let ct = cos(theta);
    let st = sin(theta);
    V1 = vec2f(V1.x * ct + V1.y * st, -V1.x * st + V1.y * ct);

    //abs. begrenzing van de wind
    let lV = length(V1);
    if(lV > maxWindsnel) {
        V1 *= maxWindsnel / max(lV, zeerKlein);
    }

    //---- druk: thermische bron (warm = lage luchtdruk) + continuïteit + diffusie ----
    //Warme lucht zet uit en verlaagt de oppervlaktedruk t.o.v. het omringende;
    //dat onderhoudt voortdurend het drukgradiënt dat de circulatie in stand houdt.
    //pSchaal = 1/resSchaal houdt de drukgolf-Courant (c·dt/d) gelijk over resolutes:
    //zonder dit lopen de gecombineerde gradP/div-koppeling bij hoge --diepte uit
    //de hand (hoge-frequentie ruis), omdat d kleiner wordt maar dt per ronde niet.
    let pSchaal = 1.0 / resSchaal;
    let thermKracht = 0.05;  //P-verlaging per K dat een cel warmer is dan zijn omgeving
    let P_doel = P0 * (1.0 - luchtAan * thermKracht * (T1 - somT));
    var P1 = P_adv + drukRelax * (P_doel - P_adv) - drukGevolg * div * pSchaal;
    P1 += drukDiffusieS * (somP - P1);

    vakken1[ID].temperatuur = goed(T1, T0, 120.0, 2000.0);
    vakken1[ID].luchtdruk   = goed(clamp(P1, minLuchtdruk, maxLuchtdruk), P0, minLuchtdruk, maxLuchtdruk);
    vakken1[ID].wind        = goedV2(V1, 0.0, -maxWindsnel, maxWindsnel);
    vakken1[ID].zonZicht    = zonZicht;
}
