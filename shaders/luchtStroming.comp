//WGSL reken-shader die de atmosferische dynamica bijwerkt: een enkellaagse
//(barotrope-achtige) circulatie met temperatuur, druk en een opgeslagen windveld.
//Dit vervangt de oude synthetische wind die elke frame uit een draaiende as werd
//verzonnen: hier evolueren T/P/wind écht, aangedreven door zonne-verwarming
//(dag/nacht + breedte), Coriolis (planeetrotatie), drukgradiënten, wrijving en
//diffusie. Straalstromen/banden ontstaan vanzelf.
//
//Voor numerieke stabiliteit op de onregelmatige geodesische grid is de wind zwaar
//gedempt (Rayleigh), begrensd op maxWindsnel en gladgestreken; de druk reageert
//zacht op divergentie en warmte en wordt sterker gediffundeerd.
//
//Draait ná waterGemiddelde en vóór waterLucht. Leest T/P/wind uit vakken0,
//schrijft de nieuwe waarden naar vakken1.
#include "planeetDefinities.wgsl"

//De wind wordt zwaarder gedempt (Rayleigh) en zwakker door de drukgradiënt
//aangedreven dan voorheen, zodat de velden onder de cap blijven en er coherente
//(grootschalige, samenhangende) circulatie-ellipsen/banden ontstaan i.p.v. dat
//élke cel tegelijk tegen de cap maxWindsnel wordt geperst (waar de richtingen
//onderling uitmiddelen tot ~0 en de wolken niets om te dragen hebben).
const winddemping  = 0.35;   //fractie wind die per ronde door wrijving remt (groter = rustiger/gebalanceerd)
const maxWindsnel  = 2.0;    //abs. windsnelheidsgrens; bewust onder de evenwichtssnelheid zodat het veld nooit vol raakt
const windDiffusie = 0.45;   //hoe sterk de wind naar het buurgemiddelde toe smoort (verwijdert grid-ruis → coherente banden)
const drukGevolg   = 0.04;   //hoe sterk wind-divergentie de druk verandert
const coriolisKracht = 3.0; //schaal van de Coriolis-afbuiging (laat geostrofisch evenwicht + jets ontstaan)
const terrainKracht  = 0.15; //schaal van de terrein-forcering (wervels rond bergen, minder ruis)

//Temperatuur en druk advecteren veel zwakker mee dan het vocht: alleen een zachte
//meetrek-beweging (sub-cel), zodat de diffusie/uitstraling kan overheersen en er
//geen fijnschalige draaikolken/ruis in T/P ontstaan. Het vocht (damp/wolk) advecteert
//voluit via vochtStroming; hier voldoet een zwakke druk/waarde meebewegen.
const TPAdvectieZwakte = 0.12;

@compute @workgroup_size(64)
fn main(@builtin(global_invocation_id) gid : vec3u) {
    let ID = gid.x;
    let aantal = arrayLength(&vakken0);
    if(ID >= aantal) { return; }

    let hier = vakMetas[ID].normaal.xyz;
    let burenAantal = vakMetas[ID].burenAantal;
    let n = f32(burenAantal);

    //Masterschakelaar: zonkracht (reken.atmosfeer.x) > 0 zet de circulatie aan.
    //Met 0 blijft de lucht volledig stil (handig als --no-atmosfeer-parachute).
    let luchtAan = select(0.0, 1.0, reken.atmosfeer.x > 0.0);

    let opp = vakken0[ID].grondHoogte + vakken0[ID].waterHoogte;
    let hoogteFrac = clamp((opp - minGrondHoogte) / (maxGrondHoogte - minGrondHoogte), 0.0, 1.0);

    let T0 = vakken0[ID].temperatuur;
    let P0 = vakken0[ID].luchtdruk;
    let V0 = vakken0[ID].wind;

    //---- zonne-verwarming (zon vast in modelruimte; de planeet draait) ----
    let zon     = normalize(reken.zonRicht.xyz);
    //Instralingshoek: vergelijk de normaal van de cel met de invalsrichting van het
    //licht. Als nagelrecht tegenover het licht staat (dot==-1) is de instraling
    //maximaal; zodra de normaal weg of haaks op het licht staat (dot>=0) is er geen
    //instraling meer. Kwadratisch, zodat scherende straling snel afvalt.
    let ins     = pow(max(0.0, clamp(dot(-hier, zon), 0.0, 1.0)), 4.0);
    let noord   = vec3f(0.0, 1.0, 0.0);              //vaste geografische rotatie-as
    let breedte = clamp(dot(hier, noord), -1.0, 1.0); //+1 = noordpool

    //Echte energiebalans (geen breedte-verzonnen evenwicht meer):
    // 1) zoninstraling met invalshoek (ins = cos van de zonhoogte; scherende
    //    straling valt over meer oppervlak -> minder warmte per cel),
    // 2) gemoduleerd door het albedo van de getoonde oppervlakte (ijs/wolk/water/grond/leven),
    // 3) uitstraling naar de ruimte, afgeremd door het wolkendek,
    // 4) CO2-broeikaseffect zodat niet de hele planeet bevriest.
    //De lucht-T telt door van de vorige stap en wordt advecteerd met de wind.
    let lokaalAlbedo = select(albedoIJs, select(albedoWolken, select(albedoWater, albedoGrond,
                          vakken0[ID].waterHoogte > 0.5), vakken0[ID].wolken > 0.003),
                          vakken0[ID].ijs > 0.01);
    let albedo = mix(lokaalAlbedo, albedoBegroei, clamp(vakken0[ID].leven, 0.0, 1.0));

    let zonWarmte = reken.atmosfeer.x * (1.0 - albedo) * ins;

    //Wolkendek houdt de uitstraling deels tegen (atmosfeer wordt 'dikker' waar bewolkt)
    let wolkBedekking = clamp(vakken0[ID].wolken * 10.0, 0.0, 1.0);
    let afkoelen = stralingKracht * (1.0 - wolkIsolatie * wolkBedekking);

    //Effectieve hemeltemperatuur door CO2-broeikaseffect, met hoogte-koeling
    //(lapse rate) ingebouwd in het stralingsevenwicht: hoger -> kouder doel.
    let ruimteEffectief = ruimteK + broeikasK - lapseKoeling * hoogteFrac;

    //---- advectie van T en P met de huidige wind (semi-Lagrangiaans) ----
    //Vroeger eerste-orde upwind: één donorcel, mengstapje geklemd op 0.35, waardoor
    //T/P nauwelijks meetrokken en de wolken (die wél de volle semi-Lagrangiaanse
    //tracer gebruiken) een eigen, losgekoppeld pad volgden. Nu volgen T en P dézelfde
    //multi-cel achterwaartse traject-interpolatie als het vocht in waterLucht, zodat
    //temperatuur, druk én wolken met één samenhangend luchtpakket meereizen.
    //---- advectie van T en P met de wind (fluxvormig, donor-cel) ----
    //Eén gezamenlijke "luchtcel" verplaatst zich: temperatuur en druk reizen met
    //díézelfde face-snelheid (windU) als het vocht in vochtStroming, zodat alle
    //atmosferische grootheden als één gemengd luchtpakket meebewegen. Elke scalar
    //heeft een eigen claim-limit (K) die alleen de UITGAANDE flux beperkt, zodat
    //een cel nooit meer wegstuurt dan hij bezit (geen onder-uitschot).
    var netT = 0.0;
    var netP = 0.0;
    var fluxenT = 0.0;
    var fluxenP = 0.0;
    for(var av = 0u; av < burenAantal && av < maxBuren; av++) {
        let avU  = windU(ID, av);
        let avNb = vakMetas[ID].buren[av];
        let c    = dtAdvPerL() * TPAdvectieZwakte;
        let Tdon = select(vakken0[avNb].temperatuur, T0, avU >= 0.0);
        let Pdon = select(vakken0[avNb].luchtdruk,   P0, avU >= 0.0);
        netT -= avU * Tdon * c;
        netP -= avU * Pdon * c;
        fluxenT += max(0.0, avU) * Tdon * c;
        fluxenP += max(0.0, avU) * Pdon * c;
    }
    let KT = fluxK(T0, fluxenT);
    let KP = fluxK(P0, fluxenP);
    //beperk alleen de uitgaande flux (outflow) terug; binnenkomende blijft ongemoeid
    let T_adv = T0 + netT + (1.0 - KT) * fluxenT;
    let P_adv = P0 + netP + (1.0 - KP) * fluxenP;

    //---- wind: drukgradiënt + Coriolis + wrijving + diffusie + terrein ----
    var somW     = vec2f(0.0);
    var gradiënt = vec2f(0.0);
    var somP     = 0.0;
    var somT     = 0.0;
    var div      = 0.0;
    var terreinGrad = vec2f(0.0);
    for(var buur = 0u; buur < burenAantal && buur < maxBuren; buur++) {
        let buurId = buurID(ID, buur);
        let richt  = vakMetas[ID].buurRicht[buur];
        somW     += vakken0[buurId].wind;
        gradiënt += (vakken0[buurId].luchtdruk - P0) * richt;
        somP     += vakken0[buurId].luchtdruk;
        somT     += vakken0[buurId].temperatuur;
        div      += dot(V0, richt);
        terreinGrad += (vakken0[buurId].grondHoogte - vakken0[ID].grondHoogte) * richt;
    }
    somW     /= n;
    gradiënt /= n;
    somP     /= n;
    somT     /= n;
    div      /= n;
    terreinGrad /= n;

    //---- temperatuur-update: warmte erbij (zon), af (uitstraling) + diffusie ----
    //Zonder atmosfeer (reken.atmosfeer.x = 0) blijft de temperatuur stil.
    //Diffusie (somT - T_adv) verdeelt de warmte over de buren: zonder dit blijft
    //de dagzijde te heet en te droog en de nachtzijde te koud, waardoor damp nooit
    //in de buurt van verzadiging komt en er geen wolken ontstaan.
    let T1 = select(T_adv,
        T_adv
        + opnameTempo * zonWarmte * tijdVerschil
        - afkoelen * (T_adv - ruimteEffectief) * tijdVerschil
        + tempDiffusie * (somT - T_adv),
        luchtAan > 0.0);

    //Coriolis: f = 2 Omega * breedte; 90°-draaiing in het raakvlak.
    //Eigen coëfficiënt (coriolisKracht) zodat de Coriolis-kromming zichtbaar wordt
    //zonder dat de demping hem wegveegt. In het (west, noord)-raakvlak is de 90°-
    //draaiing "-draaiing (-V.y, V.x)". Let op: de lokale noord-as van het raakvlak
    //(buurRicht.y, zie planeet.cpp) wijst naar het ZUIDEN; met deze rotatie én die
    //noord-conventie bloeft de druk noord/zuid evenwichtig (geen pool-cirkulatie).
    let fgeo = 2.0 * reken.atmosfeer.y * breedte;
    let cor  = vec2f(-V0.y, V0.x) * fgeo * coriolisKracht;

    //Terrein-forcering: het vaste hoogteveld buigt de stroming om bergen/flanken
    //heen en werkt als een permanente (fysieke) ruisbron. Flow die een helling
    //oversteekt krijgt verticale vorticiteit → benedenstrooms ontstaan kolken en
    //heuvelluwten die door de wind worden meegevoerd.
    let terreinDruk = clamp(dot(V0, terreinGrad), -1.0, 1.0);
    let terreinForce = terrainKracht * (terreinGrad * (1.0 + 2.0 * terreinDruk));

    var V1 = V0
           - drukKracht * gradiënt                     //drukgradiëntkracht
           + cor                                         //coriolis
           + terreinForce                                 //terrein (wervels/omleiding)
           - winddemping * V0                             //Rayleigh-wrijving (sterk)
           + windDiffusie * (somW - V0);                 //diffusie: smoot de wind tot grootschalige, coherente stroming

    //abs. begrenzing van de wind
    let lV = length(V1);
    if(lV > maxWindsnel) {
        V1 *= maxWindsnel / max(lV, zeerKlein);
    }

    //---- druk: thermische bron (warm = lage luchtdruk) + continuïteit + diffusie ----
    //Warme lucht zet uit en verlaagt de oppervlaktedruk t.o.v. het omringende;
    //dat onderhoudt voortdurend het drukgradiënt dat de circulatie in stand houdt.
    let thermKracht = 0.008;  //P-verlaging per K dat een cel warmer is dan zijn omgeving
    let P_doel = P0 * (1.0 - luchtAan * thermKracht * (T1 - somT));
    var P1 = P_adv + drukRelax * (P_doel - P_adv) - drukGevolg * div;
    P1 += drukDiffusie * (somP - P1);

    vakken1[ID].temperatuur = goed(T1, T0, 120.0, 2000.0);
    vakken1[ID].luchtdruk   = goed(clamp(P1, minLuchtdruk, maxLuchtdruk), P0, minLuchtdruk, maxLuchtdruk);
    vakken1[ID].wind        = goedV2(V1, 0.0, -maxWindsnel, maxWindsnel);
}
